# ============ 方案 A：云端 OpenAI 兼容接口（推荐，快 10 倍） ============
# 任何兼容 /chat/completions 的服务都能用，只改这三行。
# LLM_MODEL 必须和服务端 /v1/models 返回的 id 一字不差，写错会得到
# 404 model not found —— 这一条曾经让 7 条用例全被判成"未攻破"。
#
# 示例（商汤日日新网关）：
# LLM_BASE_URL=https://token.sensenova.cn/v1
# LLM_API_KEY=sk-xxxxxx
# LLM_MODEL=glm-5.3
#
# 示例（DeepSeek 官方）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxx
# LLM_MODEL=deepseek-chat

# 单次调用最大 token。推理模型会先"思考"，预算给小了 JSON 动作会被截断，
# 表现为"空转"而不是"拒答"——两种失败模式很好混，调参时注意。
LLM_MAX_TOKENS=2048

# ============ 方案 B：本地 Ollama（免费不限量，慢 3~10 倍） ============
# 1) 装 Ollama: https://ollama.com
# 2) ollama pull deepseek-r1:7b
# 3) 取消下面几行的注释
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=deepseek-r1:7b
